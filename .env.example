# 团结引擎 RPG 服务端凭据模板 - 复制为 .env 并填入实际值
# cp .env.example .env

# Database
HQ_DATABASE_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Redis
HQ_REDIS_PASSWORD=changeme

# MongoDB
HQ_MONGO_PASSWORD=changeme
HQ_MONGODB_URI=mongodb://mongo_root:changeme@mongodb:27017

# JWT (use a long random string in production)
HQ_JWT_SECRET=change-this-to-a-long-random-string

# Grafana
GF_ADMIN_PASSWORD=changeme
